# Settings for running the pipeline from YOUR computer (python -m src.pipeline ...).
# Inside Docker, docker-compose.yml sets these itself.

# Warehouse = the PostgreSQL container from docker-compose.yml (port 5433 on your PC)
DB_USER=karoo
DB_PASSWORD=karoo
DB_HOST=localhost
DB_PORT=5433
DB_NAME=karoo

# Payments API (the payments-api container, or python simulator/payments_api.py)
PAYMENTS_API_URL=http://127.0.0.1:8000
PAYMENTS_API_KEY=dev-secret-key
CHAOS=1
